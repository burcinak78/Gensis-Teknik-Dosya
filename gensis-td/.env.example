# Copy to .env and fill in. Never commit .env.

# Host ports (127.0.0.1 only) — block 10200, see DURAK-DEV infra/ports.md
PROXY_PORT=10201
BACKEND_PORT=10202
STORAGE_PORT=10203

# PostgreSQL
DB_NAME=gensis_td
DB_USER=gensis_td
DB_PASSWORD=change-me

# Session signing key, at least 32 chars: openssl rand -base64 48
JWT_SECRET=
# false only for plain-http local testing
SECURE_COOKIE=false

# MinIO (S3). Public URL must be reachable from the browser for presigned links.
MINIO_ROOT_USER=gensis-td
MINIO_ROOT_PASSWORD=change-me-min-8-chars
STORAGE_PUBLIC_URL=http://localhost:10203

# First user, created only when the users table is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=

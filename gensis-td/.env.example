# Copy to .env and fill in. Never commit .env.

# Host ports (127.0.0.1 only) — block 10200, see DURAK-DEV infra/ports.md
PROXY_PORT=10201
BACKEND_PORT=10202
STORAGE_PORT=10203

# PostgreSQL
DB_NAME=gensis_td
DB_USER=gensis_td
DB_PASSWORD=change-me
# Restricted role the backend connects with; created by the migrate service. Use hex: openssl rand -hex 24
DB_APP_USER=gensis_td_app
DB_APP_PASSWORD=change-me-too

# Session signing key, at least 32 chars: openssl rand -base64 48
JWT_SECRET=
# false only for plain-http local testing
SECURE_COOKIE=false

# MinIO (S3). Public URL must be reachable from the browser for presigned links.
MINIO_ROOT_USER=gensis-td
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Backend's key, limited to its buckets; created by the storage-init service (secret: 8+ chars)
MINIO_APP_USER=gensis-td-app
MINIO_APP_PASSWORD=change-me-min-8-chars-too
STORAGE_PUBLIC_URL=http://localhost:10203

# First user, created by the migrate service only when the users table is empty.
# Can be removed from .env once that user exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend (Next.js) — server-side address of the backend; never sent to the browser.
BACKEND_INTERNAL_URL=http://backend:8080
# Only for `next dev` on the host without the proxy, e.g. http://localhost:10202
API_PROXY_URL=
